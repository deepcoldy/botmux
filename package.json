{
  "name": "botmux",
  "version": "0.0.0",
  "description": "Bridge between IM platforms and AI coding CLIs — one topic, one CLI session with live streaming",
  "type": "module",
  "main": "dist/index-daemon.js",
  "bin": {
    "botmux": "dist/cli.js"
  },
  "files": [
    "dist/",
    "ecosystem.config.cjs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "pnpm audit:domains && node scripts/clean-dist.mjs && tsc && node scripts/generate-runtime-build-id.mjs && cp src/setup/lark-scopes.json dist/setup/ && pnpm dashboard:bundle && chmod +x dist/cli.js && node scripts/audit-dist.mjs",
    "workflow-core:build": "node scripts/build-workflow-core-package.mjs",
    "workflow-core:test": "pnpm workflow-core:build && node scripts/test-workflow-core-package.mjs",
    "workflow-core:pack": "pnpm workflow-core:build && node scripts/pack-workflow-core-package.mjs",
    "audit:domains": "node scripts/audit-public-domains.mjs",
    "dashboard:bundle": "node scripts/build-dashboard.mjs",
    "dashboard:watch": "node scripts/build-dashboard.mjs --watch",
    "daemon": "tsx src/index-daemon.ts",
    "daemon:start": "node dist/cli.js start",
    "daemon:stop": "node dist/cli.js stop",
    "daemon:restart": "node dist/cli.js restart",
    "daemon:logs": "node dist/cli.js logs",
    "daemon:status": "node dist/cli.js status",
    "use:here": "node scripts/claim-botmux-bin.mjs",
    "creds:sync": "node dist/cli.js suspend --isolated",
    "switch:here": "pnpm build && pnpm use:here",
    "test": "vitest run --project unit",
    "test:all": "vitest run",
    "test:e2e": "vitest run --project e2e",
    "test:bench": "tsx scripts/bench-tests.ts",
    "test:codex": "vitest run --project e2e test/codex-input.e2e.ts",
    "test:gemini": "vitest run --project e2e test/gemini-input.e2e.ts",
    "test:agy": "vitest run --project e2e test/agy-input.e2e.ts",
    "bench:resource": "node --expose-gc --import tsx scripts/bench-resource.ts",
    "test:e2e-browser:setup": "tsx test/e2e-browser/setup-login.ts",
    "test:e2e-browser": "tsx scripts/run-e2e.ts",
    "report:dashboard": "tsx scripts/report-dashboard.ts",
    "desktop:bundle": "node scripts/build-desktop-icons.mjs && esbuild src/desktop/main.ts --bundle --outfile=dist/desktop/main.cjs --platform=node --format=cjs --external:electron && esbuild src/desktop/preload.ts --bundle --outfile=dist/desktop/preload.cjs --platform=node --format=cjs --external:electron && esbuild src/desktop/renderer/app.ts --bundle --outfile=dist/desktop/renderer/app.js --platform=browser --format=iife && cp src/desktop/renderer/index.html dist/desktop/renderer/index.html && cp src/desktop/renderer/style.css dist/desktop/renderer/style.css && cp -R src/desktop/assets dist/desktop/assets",
    "desktop:runtime": "node scripts/prepare-desktop-runtime.mjs",
    "desktop:smoke": "tsx scripts/desktop-smoke.ts",
    "desktop:install:local": "bash src/desktop/install-local.sh",
    "desktop:dev": "pnpm build && pnpm desktop:bundle && electron dist/desktop/main.cjs",
    "desktop:pack": "pnpm desktop:pack:local",
    "desktop:pack:local": "node scripts/desktop-pack-local.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "git config core.hooksPath scripts/git-hooks 2>/dev/null || true"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.64.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "^0.1.65",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "croner": "^10.0.1",
    "dotenv": "^17.3.1",
    "markdown-it": "^14.2.0",
    "node-pty": "^1.1.0",
    "pm2": "^7.0.3",
    "proxy-agent": "^6.5.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.21.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@midscene/web": "^1.7.6",
    "@playwright/test": "^1.58.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "@types/ws": "^8.18.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.1",
    "memfs": "^4.57.1",
    "playwright": "^1.58.2",
    "react-test-renderer": "19.2.7",
    "tsx": "^4.20.5",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "node-pty"
    ],
    "overrides": {
      "axios@>=1.0.0 <1.18.0": ">=1.18.0",
      "protobufjs@<7.6.5": "7.6.5",
      "@protobufjs/utf8@<1.1.1": "1.1.2",
      "systeminformation@<5.31.7": "5.33.1",
      "qs@>=6.11.1 <6.15.2": "6.15.3",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "follow-redirects@<1.16.0": "1.16.0",
      "fast-uri@>=3.0.0 <3.1.4": "3.1.5",
      "basic-ftp@<5.3.1": "5.3.1",
      "ip-address@<10.1.1": "10.4.0",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.1",
      "lodash@<4.18.0": "4.18.1",
      "linkify-it@<5.0.2": "5.0.2",
      "ws@>=8.0.0 <8.21.0": "8.21.1",
      "ws@>=7.0.0 <7.5.11": "7.5.13",
      "sharp@<0.35.0": "0.35.3",
      "uuid@<11.1.1": "11.1.1",
      "undici@>=8.0.0 <8.5.0": "8.9.0",
      "undici@<6.27.0": "6.28.0",
      "postcss@<8.5.18": "8.5.25",
      "picomatch@>=4.0.0 <4.0.4": "4.0.5",
      "picomatch@<2.3.2": "2.3.2",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "vite": "^7.3.6",
      "markdown-it@<14.2.0": "14.2.0"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.5.0",
  "license": "MIT"
}

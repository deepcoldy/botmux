{
  "schema": "botmux.bytedcli-operation-catalog.v1",
  "cliVersion": "0.199.0",
  "catalogVersion": "2026-11-27.1",
  "validators": {
    "numeric-id": {
      "kind": "integer",
      "min": 1,
      "max": 9007199254740991
    },
    "repo-path": {
      "kind": "pattern",
      "source": "^[A-Za-z0-9_-]+(?:\\/[A-Za-z0-9_.-]+)+$"
    },
    "json": {
      "kind": "choice",
      "values": [
        "true"
      ]
    },
    "site": {
      "kind": "choice",
      "values": [
        "cn"
      ]
    },
    "query": {
      "kind": "bounded",
      "maxBytes": 1024
    },
    "page": {
      "kind": "integer",
      "min": 1,
      "max": 10000
    },
    "page-size": {
      "kind": "integer",
      "min": 1,
      "max": 100
    },
    "statuses": {
      "kind": "split",
      "separator": ",",
      "validator": {
        "kind": "choice",
        "values": [
          "created",
          "archived"
        ]
      }
    },
    "sort-by": {
      "kind": "choice",
      "values": [
        "LastActivityAt",
        "Path"
      ]
    },
    "sort-order": {
      "kind": "choice",
      "values": [
        "Asc",
        "Desc"
      ]
    },
    "head": {
      "kind": "branch",
      "maxBytes": 255
    },
    "author": {
      "kind": "bounded",
      "maxBytes": 128
    },
    "commit": {
      "kind": "pattern",
      "source": "^[a-fA-F0-9]{7,40}$"
    },
    "draft": {
      "kind": "choice",
      "values": [
        "true",
        "false"
      ]
    },
    "review-status": {
      "kind": "choice",
      "values": [
        "unreviewed",
        "approved",
        "rejected"
      ]
    },
    "state": {
      "kind": "choice",
      "values": [
        "open",
        "merged",
        "closed",
        "all"
      ]
    },
    "sort-by-value": {
      "kind": "choice",
      "values": [
        "CreatedAt",
        "UpdatedAt"
      ]
    },
    "file": {
      "kind": "relative-resource",
      "maxBytes": 1024
    },
    "context": {
      "kind": "integer",
      "min": 0,
      "max": 100
    },
    "max-patch-bytes": {
      "kind": "integer",
      "min": 1,
      "max": 1048576
    },
    "body": {
      "kind": "bounded",
      "maxBytes": 32768
    },
    "body-file": {
      "kind": "pattern",
      "source": "^(?:-|[A-Za-z0-9][A-Za-z0-9_-]{0,63})$"
    },
    "merge-method": {
      "kind": "choice",
      "values": [
        "merge_commit",
        "rebase_merge"
      ]
    },
    "merge-commit-message": {
      "kind": "bounded",
      "maxBytes": 4096
    },
    "reviewer-ids": {
      "kind": "any",
      "validators": [
        {
          "kind": "integer",
          "min": 1,
          "max": 9007199254740991
        },
        {
          "kind": "pattern",
          "source": "^[A-Za-z0-9_.-]{1,128}$"
        }
      ]
    },
    "about-user": {
      "kind": "pattern",
      "source": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "sort": {
      "kind": "choice",
      "values": [
        "created-at-asc",
        "created-at-desc"
      ]
    },
    "state-value": {
      "kind": "choice",
      "values": [
        "initial",
        "opened",
        "closed",
        "finished"
      ]
    },
    "psm": {
      "kind": "pattern",
      "source": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+){2,}$"
    },
    "vregion": {
      "kind": "choice",
      "values": [
        "China-North",
        "China-North6"
      ]
    },
    "output": {
      "kind": "choice",
      "values": [
        "console"
      ]
    }
  },
  "commonFlags": [
    {"name":"--json","aliases":["-j"],"arity":"flag","validator":"json"},
    {"name":"--site","arity":"value","validator":"site"},
    {"name":"--help","aliases":["-h"],"arity":"flag","validator":"json"},
    {"name":"--version","aliases":["-V"],"arity":"flag","validator":"json"}
